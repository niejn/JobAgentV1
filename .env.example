# Core runtime
JOBAGENT_ENV=development
JOBAGENT_LOG_LEVEL=INFO
JOBAGENT_LOG_FILE=data/logs/jobagent.log
JOBAGENT_DEBUG_TRACE=false
JOBAGENT_HEADLESS=true
JOBAGENT_MAX_JOBS=30
JOBAGENT_REQUEST_TIMEOUT=30
# Safe read-only document boundary: only explicitly named UTF-8 .txt/.md files
# inside this directory can be read by the Agent document tools.
JOBAGENT_WORKSPACE_ROOT=data/share

# First release: all LLM runtime variables for the OpenAI-compatible path.
# Required: JOBAGENT_LLM_PROVIDER, JOBAGENT_LLM_MODEL, OPENAI_API_KEY, OPENAI_BASE_URL.
# Supports OpenAI, DeepSeek, Volcengine Ark and other Chat Completions-compatible providers.
# Claude/Anthropic support is deferred to a later phase.
JOBAGENT_LLM_PROVIDER=openai-compatible
JOBAGENT_LLM_MODEL=deepseek-chat
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
JOBAGENT_LLM_CONTEXT_WINDOW=128000
JOBAGENT_LLM_MAX_TOKENS=4096
JOBAGENT_LLM_TIMEOUT=180
JOBAGENT_LLM_REASONING=true
JOBAGENT_LLM_SUPPORTS_DEVELOPER_ROLE=false
JOBAGENT_LLM_THINKING_FORMAT=deepseek
JOBAGENT_LLM_THINKING_LEVEL=

# OpenAI example:
# JOBAGENT_LLM_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Volcengine Ark example (replace the model with your endpoint/model ID):
# JOBAGENT_LLM_MODEL=glm-5.3
# OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
# JOBAGENT_LLM_CONTEXT_WINDOW=1024000
# JOBAGENT_LLM_MAX_TOKENS=128000

# LLM fallback chain: when the primary fails with provider-level errors
# (429 rate limit / 403 model_access_denied / 401 / 5xx / connection),
# retry once on this backup model. Leave JOBAGENT_LLM_FALLBACK_MODEL empty
# to disable. Base URL / API key default to the primary's (same gateway,
# different model); set them explicitly for a different provider.
# Example: primary glm-5.3 on Ark, backup deepseek-chat on DeepSeek:
# JOBAGENT_LLM_FALLBACK_MODEL=deepseek-chat
# JOBAGENT_LLM_FALLBACK_BASE_URL=https://api.deepseek.com/v1
# JOBAGENT_LLM_FALLBACK_API_KEY=
# JOBAGENT_LLM_FALLBACK_MAX_TOKENS=8192

# Platform auth/session values (examples)
BOSS_COOKIE=
BOSS_COOKIE_FILE=  # Full browser-exported Cookie JSON for direct HTTP/WS adapters
BOSS_SEARCH_TRANSPORT=cdp  # cdp or http; HTTP uses persisted Boss cookies for read-only search
BOSS_CONTACT_TRANSPORT=http  # cdp or http; default: CDP job reads + HTTP friend/add + WS greeting
BOSS_RISK_COOLDOWN_SECONDS=900
BOSS_MAX_SEARCHES_PER_SESSION=10
# Optional Chrome path. Empty lets JobAgent discover Chrome on Windows.
BOSS_DEBUG_CHROME_EXECUTABLE=
BOSS_DEBUG_CHROME_PROFILE_DIR=data/boss-chrome-small-profile
BOSS_DEBUG_CHROME_START_TIMEOUT_SECONDS=20
LINKEDIN_COOKIE=

# Xiaohongshu / Spider_XHS in-process backend
# Copy the complete request Cookie header; it must contain at least a1 and web_session.
XHS_COOKIE_HEADER=
SPIDER_XHS_PATH=../xiaohongshu_crawler/Spider_XHS
XHS_DOWNLOAD_DIR=data/xhs
XHS_API_RATE_REQUESTS=1
XHS_API_RATE_PERIOD_SECONDS=1
XHS_MEDIA_RATE_REQUESTS=1
XHS_MEDIA_RATE_PERIOD_SECONDS=1
# Optional read-only Chrome CDP fallback for XHS note/author reads.
# Requires Chrome already running with --remote-debugging-port=9222 and a
# logged-in xiaohongshu.com tab. Loopback endpoints only; JobAgent never
# launches the browser or reads its cookies. Fallback triggers at most once
# and only for token/access-control failures of the primary backend.
XHS_CDP_ENABLED=false
DEBUG_CHROME_CDP_ENDPOINT=http://127.0.0.1:9222
XHS_CDP_TIMEOUT_SECONDS=30
JOBAGENT_STATE_DB=data/jobagent.db
JOBAGENT_CHECKPOINT_DB=data/jobagent-checkpoints.db
JOBAGENT_ARTIFACT_DIR=data/journeys
JOBAGENT_OPPORTUNITY_DIR=data/opportunities
JOBAGENT_OCR_ENGINE=tesseract
TESSERACT_CMD=tesseract
JOBAGENT_OCR_LANGUAGE=chi_sim+eng
JOBAGENT_OCR_PSM=11
JOBAGENT_RESEARCH_MAX_ITERATIONS=3
JOBAGENT_RESEARCH_QUERIES_PER_ITERATION=4
JOBAGENT_RESEARCH_RESULTS_PER_QUERY=8
JOBAGENT_RESEARCH_MINIMUM_EVIDENCE=3
JOBAGENT_RESEARCH_REQUIRED_TOPICS=3
JOBAGENT_RESEARCH_TIMEOUT=300

# Boss直聘 application settings
BOSS_GREETING=                  # Greeting template, supports $company $title $name
BOSS_APPLY_DELAY_MIN=3.0       # Min seconds between applications
BOSS_APPLY_DELAY_MAX=8.0       # Max seconds between applications
BOSS_DAILY_LIMIT=100           # Daily application cap (1-150)
BOSS_SKIP_INACTIVE_DAYS=7

# Boss pacing: human-like rhythm (1 page / 30s + 8-25s reading pause).
# 1/s got back-to-back searches anti-bot flagged (2026-08-27).
BOSS_CRAWL_RATE_REQUESTS=1
BOSS_CRAWL_RATE_PERIOD_SECONDS=30
BOSS_CRAWL_JITTER_MIN_SECONDS=8
BOSS_CRAWL_JITTER_MAX_SECONDS=25      # Skip HR inactive for N days

# Notification channels
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# Optional network settings
HTTP_PROXY=
HTTPS_PROXY=
